# msmtp/msmtprc
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp.log
aliases        /etc/aliases

# Gmail
account        gmail
host           smtp.gmail.com
port           587
from           %%NOTIFICATIONFROMADDRESS%%
user           %%NOTIFICATIONFROMADDRESS%%
password       %%GMAILSMTPPASSWORD%%

# Set a default account
account default: gmail
