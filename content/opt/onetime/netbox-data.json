{
    "extras.tags": [{
        "color": "00bcd4",
        "name": "Icinga Endpoint",
        "slug": "icinga-endpoint"
    }],
    "tenancy.contact-groups": [{
        "name": "Awesome",
        "slug": "awesome"
    }],
    "tenancy.contacts": [{
        "name": "Mark Coleman",
        "email": "mcoleman@netboxlabs.com",
        "group": {"name": "Awesome"}
    },{
        "name": "Matthew Smith",
        "email": "matthew.smith@sol1.com.au",
        "group": {"name": "Awesome"}
    },{
        "name": "Dave Kempe",
        "email": "dave@sol1.com.au",
        "group": {"name": "Awesome"}
    }],
    "extras.custom-field-choice-sets": [{
        "extra_choices": [["no_not_monitor","Do not monitor"],["default","Default"]],
        "name": "icinga_import_source_choices"
    }],
    "extras.custom-fields": [{
            "weight": "100",
            "filter_logic": "loose",
            "search_weight": "100",
            "object_types": ["dcim.device", "virtualization.virtualmachine"],
            "type": "select",
            "name": "icinga_import_source",
            "group_name": "Monitoring",
            "choice_set": {"name": "icinga_import_source_choices"}
        },
        {
            "weight": "100",
            "filter_logic": "loose",
            "search_weight": "100",
            "object_types": ["dcim.device", "virtualization.virtualmachine"],
            "type": "text",
            "name": "ping_target",
            "group_name": "Monitoring"
        },
        {
            "weight": "100",
            "filter_logic": "loose",
            "search_weight": "100",
            "object_types": ["dcim.platform"],
            "type": "text",
            "name": "platform_type"
        },
        {
            "weight": "110",
            "filter_logic": "loose",
            "search_weight": "110",
            "object_types": ["dcim.platform"],
            "type": "text",
            "name": "platform_version"
        },
        {
            "weight": "120",
            "filter_logic": "loose",
            "search_weight": "120",
            "object_types": ["dcim.platform"],
            "type": "text",
            "name": "platform_family"
        },
        {
            "weight": "100",
            "filter_logic": "loose",
            "search_weight": "100",
            "object_types": ["tenancy.contact"],
            "type": "text",
            "group_name": "Pushover",
            "name": "pushover_user"
        },
        {
            "weight": "100",
            "filter_logic": "loose",
            "search_weight": "100",
            "object_types": ["tenancy.contact"],
            "type": "text",
            "group_name": "Pushover",
            "name": "pushover_token"
        }
    ],

    "dcim.manufacturers": [
        {"name": "Google", "slug": "google"},
        {"name": "Generic", "slug": "generic"}
    ],
    "dcim.device-types": [
        {"manufacturer": {"slug": "google"}, "model": "Public DNS", "slug": "google-public-dns"},
        {"manufacturer": {"slug": "generic"}, "model": "Generic Appliance", "slug": "generic-appliance"}
    ],
    "dcim.device-roles": [
        {"name": "DNS Server", "slug": "dns-server", "color": "2196f3"},
        {"name": "Gateway", "slug": "gateway", "color": "9c27b0"},
        {"name": "Server", "slug": "server", "color": "4caf50"}
    ],
    "dcim.sites": [
        {"name": "Demo Site", "slug": "demo-site", "status": "active"}
    ],
    "virtualization.cluster-types": [
        {"name": "Demo Hypervisor", "slug": "demo-hypervisor"}
    ],
    "virtualization.clusters": [
        {"name": "Demo Cluster", "type": {"slug": "demo-hypervisor"}, "status": "active"}
    ],

    "dcim.devices": [
        {
            "name": "google-dns",
            "device_type": {"slug": "google-public-dns"},
            "role": {"slug": "dns-server"},
            "site": {"slug": "demo-site"},
            "status": "active",
            "description": "Google Public DNS (demo) - address comes from its primary IP",
            "custom_fields": {"icinga_import_source": "default"}
        },
        {
            "name": "gateway",
            "device_type": {"slug": "generic-appliance"},
            "role": {"slug": "gateway"},
            "site": {"slug": "demo-site"},
            "status": "active",
            "description": "Default gateway of the Icinga host (demo) - primary IP detected at runtime",
            "custom_fields": {"icinga_import_source": "default"}
        },
        {
            "name": "google.com",
            "device_type": {"slug": "generic-appliance"},
            "role": {"slug": "server"},
            "site": {"slug": "demo-site"},
            "status": "active",
            "description": "Web (demo) - no primary IP, so the host name is used as the address",
            "custom_fields": {"icinga_import_source": "default"}
        }
    ],

    "virtualization.virtual-machines": [
        {
            "name": "cloudflare-dns",
            "cluster": {"name": "Demo Cluster"},
            "status": "active",
            "vcpus": "1",
            "memory": "512",
            "description": "Cloudflare DNS (demo VM) - address comes from its primary IP 1.1.1.1",
            "custom_fields": {"icinga_import_source": "default"}
        },
        {
            "name": "${VM_NAME}",
            "cluster": {"name": "Demo Cluster"},
            "status": "active",
            "vcpus": "${VM_VCPUS}",
            "memory": "${VM_MEMORY_MB}",
            "description": "The Icinga POC host itself, as a VM (demo) - no primary IP, name is used",
            "custom_fields": {"icinga_import_source": "default"}
        }
    ],

    "dcim.interfaces": [
        {"device": {"name": "google-dns"}, "name": "eth0", "type": "virtual"},
        {"device": {"name": "gateway"}, "name": "eth0", "type": "virtual"}
    ],
    "virtualization.interfaces": [
        {"virtual_machine": {"name": "cloudflare-dns"}, "name": "eth0"}
    ],

    "ipam.ip-addresses": [
        {"address": "8.8.8.8/32", "status": "active",
         "assign": {"kind": "device", "parent": "google-dns", "interface": "eth0"}},
        {"address": "${DEFAULT_GATEWAY}/24", "status": "active",
         "assign": {"kind": "device", "parent": "gateway", "interface": "eth0"}},
        {"address": "1.1.1.1/32", "status": "active",
         "assign": {"kind": "vm", "parent": "cloudflare-dns", "interface": "eth0"}}
    ],

    "primary-ips": [
        {"kind": "device", "name": "google-dns", "address": "8.8.8.8/32"},
        {"kind": "device", "name": "gateway", "address": "${DEFAULT_GATEWAY}/24"},
        {"kind": "vm", "name": "cloudflare-dns", "address": "1.1.1.1/32"}
    ]
}
